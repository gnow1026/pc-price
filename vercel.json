{
    "version": 2,
    "builds": [
        {
            "src": "api/estimate.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/estimate",
            "dest": "/api/estimate.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
