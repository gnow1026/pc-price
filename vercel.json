{
    "version": 2,
    "installCommand": "npm install",
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/estimate",
            "dest": "/api/estimate.js"
        },
        {
            "src": "/api/crawl",
            "dest": "/api/crawl.js"
        },
        {
            "src": "/api/parts",
            "dest": "/api/parts.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
