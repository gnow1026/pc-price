{
    "version": 2,
    "installCommand": "npm install",
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "*.js",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/estimate",
            "dest": "/api/estimate.js"
        },
        {
            "src": "/api/crawl",
            "dest": "/api/crawl.js"
        },
        {
            "src": "/api/parts",
            "dest": "/api/parts.js"
        },
        {
            "src": "/api/search",
            "dest": "/api/search.js"
        },
        {
            "src": "/api/cleannames",
            "dest": "/api/cleannames.js"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/style.css",
            "dest": "/style.css"
        },
        {
            "src": "/script.js",
            "dest": "/script.js"
        }
    ]
}
